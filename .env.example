# Copy this file to .env and fill in your own values.
# .env is git-ignored on purpose — never commit real credentials.

# Postgres connection string (matches docker-compose.yml's default credentials
# if you're running the bundled db service as-is)
DATABASE_URL=postgresql://papernet:papernet_dev_password@localhost:5432/papernet

# Port the Express server listens on
PORT=3000

# Local embedding model used by @huggingface/transformers
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2

# --- Optional ---
# These can also be set later from the in-app Settings panel (stored in the
# `settings` table), which takes priority over these env vars if both are set.
OPENALEX_API_KEY=
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
